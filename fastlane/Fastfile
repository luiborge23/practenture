default_platform(:ios)

platform :ios do
  desc "Run tests"
  lane :test do
    run_tests(
      project: "Practenture.xcodeproj",
      scheme: "Practenture",
      devices: ["iPhone 16 Pro", "iPad Pro 13-inch (M4)"],
      code_coverage: true
    )
  end

  desc "Build for staging"
  lane :staging do
    gym(
      project: "Practenture.xcodeproj",
      scheme: "Practenture",
      configuration: "Debug",
      destination: "generic/platform=iOS",
      export_method: "development",
      output_directory: "./build",
      output_name: "Practenture-staging"
    )
  end

  desc "Build for release and upload to App Store Connect"
  lane :release do
    match(
      type: "appstore",
      app_identifier: "com.luisborges.bizsim.Practenture"
    )
    gym(
      project: "Practenture.xcodeproj",
      scheme: "Practenture",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Practenture-release"
    )
    deliver(
      skip_screenshots: true,
      skip_metadata: true,
      force: true
    )
  end

  desc "Increment build number and commit"
  lane :bump do
    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "Practenture.xcodeproj"
    )
    commit_version_bump(
      message: "Bump build number",
      xcodeproj: "Practenture.xcodeproj"
    )
  end
end
