# Copy to .env for local deployment. Never commit real values.
PRACTENTURE_JWT_SECRET=
PRACTENTURE_OWNER_USERNAME=owner
PRACTENTURE_OWNER_PASSWORD=
PRACTENTURE_PROFESSOR_USERNAME=professor
PRACTENTURE_PROFESSOR_PASSWORD=
PRACTENTURE_JWT_EXPIRY_HOURS=24
PRACTENTURE_APPLE_AUDIENCE=
PRACTENTURE_GOOGLE_AUDIENCE=
PRACTENTURE_CORS_ORIGINS=https://practenture.com,https://www.practenture.com,https://api.practenture.com
PRACTENTURE_EMAIL_PROVIDER=ses
PRACTENTURE_SES_REGION=us-east-1
PRACTENTURE_SES_SENDER=
PRACTENTURE_PUBLIC_ORIGIN=https://practenture.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Restrict proxy headers to the Docker network containing nginx; do not use *.
FORWARDED_ALLOW_IPS=172.16.0.0/12
