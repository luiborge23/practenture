# Copy to .env for local deployment. Never commit real values.
PRACTENTURE_JWT_SECRET=
# Dedicated stable key for deletion markers and provider-revocation jobs.
# Do not rotate this with PRACTENTURE_JWT_SECRET.
PRACTENTURE_PROVIDER_JOB_ENCRYPTION_KEY=
PRACTENTURE_OWNER_USERNAME=owner
PRACTENTURE_OWNER_PASSWORD=
PRACTENTURE_PROFESSOR_USERNAME=professor
PRACTENTURE_PROFESSOR_PASSWORD=
PRACTENTURE_JWT_EXPIRY_HOURS=24
PRACTENTURE_APPLE_AUDIENCE=
PRACTENTURE_APPLE_TEAM_ID=
PRACTENTURE_APPLE_KEY_ID=
# PKCS#8 ES256 private key; encode PEM newlines as literal \n in this file.
PRACTENTURE_APPLE_PRIVATE_KEY=
PRACTENTURE_GOOGLE_AUDIENCE=
PRACTENTURE_CORS_ORIGINS=https://practenture.com,https://www.practenture.com,https://api.practenture.com
PRACTENTURE_EMAIL_PROVIDER=ses
PRACTENTURE_SES_REGION=us-east-1
PRACTENTURE_SES_SENDER=
PRACTENTURE_PUBLIC_ORIGIN=https://practenture.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Restrict proxy headers to the Docker network containing nginx; do not use *.
FORWARDED_ALLOW_IPS=172.16.0.0/12


# SES feedback (create this topic in the same region as SES, then subscribe
# https://practenture.com/api/email/ses-feedback and enable Bounce/Complaint events).
PRACTENTURE_SES_SNS_TOPIC_ARN=
# Generate once with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep this value stable and secret; ec2-deploy.sh generates/preserves it automatically.
PRACTENTURE_EMAIL_SUPPRESSION_KEY=
