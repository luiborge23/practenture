<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── Google Sign-In (REQUIRED) ────────────────────────────────── -->
	<!-- Get your client ID from: https://console.cloud.google.com/apis/credentials -->
	<!-- It looks like: 1234567890-abc.apps.googleusercontent.com -->
	<key>GIDClientID</key>
	<string>741219112789-tjgo4468alu6aujghk96p1ihst5c7uk7.apps.googleusercontent.com</string>

	<!-- Reversed client ID for URL scheme (same ID, reversed dot order) -->
	<!-- e.g. if GIDClientID = 1234567890-abc.apps.googleusercontent.com -->
	<!-- then this = com.googleusercontent.apps.1234567890-abc -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.741219112789-tjgo4468alu6aujghk96p1ihst5c7uk7</string>
			</array>
		</dict>
	</array>

	<!-- ── Backend URL (configurable per scheme via xcconfig) ──────── -->
	<key>PRACTENTURE_BACKEND_URL</key>
	<string>https://api.practenture.com</string>

	<!-- ── Encryption Exemption (App Store Connect Compliance) ─────── -->
	<!-- App uses only HTTPS/TLS encryption provided by iOS system -->
	<!-- No custom/proprietary encryption algorithms implemented -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
